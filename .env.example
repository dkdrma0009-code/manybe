# ──────────────────────────────────────────────────────────────────────────────
# MANYBE — Environment Variable Template
# Copy this file to .env (development) or configure via EAS secrets (production).
# NEVER commit .env / .env.development / .env.production to git.
# ──────────────────────────────────────────────────────────────────────────────

# Environment identifier (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=

# Anonymous (public) key — safe to expose, RLS is your security layer
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── External APIs ─────────────────────────────────────────────────────────────
# YouTube Data API v3 — optional, disables YouTube integration if missing
EXPO_PUBLIC_YOUTUBE_API_KEY=

# ── RevenueCat (Monetization) ─────────────────────────────────────────────────
# Get keys from RevenueCat dashboard → Project → API Keys
# Leave empty until react-native-purchases is installed and configured
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
